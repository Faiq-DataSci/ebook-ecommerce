generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  CUSTOMER
  ADMIN
}

enum OrderStatus {
  PENDING
  PAID
  FAILED
  EXPIRED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  VERIFIED
  FAILED
  EXPIRED
}

model User {
  id             String         @id @default(uuid()) @db.Uuid
  supabaseUserId String         @unique @map("supabase_user_id")
  fullName       String         @map("full_name") @db.VarChar(120)
  email          String         @unique @db.VarChar(150)
  phone          String?        @db.VarChar(25)
  role           UserRole       @default(CUSTOMER)
  isActive       Boolean        @default(true) @map("is_active")
  createdAt      DateTime       @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt      DateTime       @updatedAt @map("updated_at") @db.Timestamptz()

  orders         Order[]
  transactions   Transaction[]
  ebookAccesses  EbookAccess[]

  @@map("users")
}

model Category {
  id          String   @id @default(uuid()) @db.Uuid
  name        String   @unique @db.VarChar(100)
  slug        String   @unique @db.VarChar(120)
  description String?
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  ebooks      Ebook[]

  @@map("categories")
}

model Ebook {
  id            String        @id @default(uuid()) @db.Uuid
  categoryId    String        @map("category_id") @db.Uuid
  title         String        @db.VarChar(200)
  author        String        @db.VarChar(150)
  description   String
  price         Decimal       @db.Decimal(12, 2)
  coverUrl      String?       @map("cover_url")
  storagePath   String        @map("storage_path")
  pageCount     Int?          @map("page_count")
  publishedYear Int?          @map("published_year")
  ratingAvg     Decimal       @default(0) @map("rating_avg") @db.Decimal(3, 2)
  salesCount    Int           @default(0) @map("sales_count")
  isActive      Boolean       @default(true) @map("is_active")
  createdAt     DateTime      @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt     DateTime      @updatedAt @map("updated_at") @db.Timestamptz()

  category      Category      @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  orderItems    OrderItem[]
  ebookAccesses EbookAccess[]

  @@index([categoryId])
  @@index([isActive])
  @@map("ebooks")
}

model Order {
  id          String        @id @default(uuid()) @db.Uuid
  userId      String        @map("user_id") @db.Uuid
  orderNumber String        @unique @map("order_number") @db.VarChar(40)
  totalAmount Decimal       @map("total_amount") @db.Decimal(12, 2)
  status      OrderStatus   @default(PENDING)
  expiresAt   DateTime      @map("expires_at") @db.Timestamptz()
  createdAt   DateTime      @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt   DateTime      @updatedAt @map("updated_at") @db.Timestamptz()

  user          User          @relation(fields: [userId], references: [id], onDelete: Restrict)
  items         OrderItem[]
  payments      Payment[]
  transaction   Transaction?
  ebookAccesses EbookAccess[]

  @@index([userId])
  @@index([status])
  @@map("orders")
}

model OrderItem {
  id        String   @id @default(uuid()) @db.Uuid
  orderId   String   @map("order_id") @db.Uuid
  ebookId   String   @map("ebook_id") @db.Uuid
  unitPrice Decimal  @map("unit_price") @db.Decimal(12, 2)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()

  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  ebook     Ebook    @relation(fields: [ebookId], references: [id], onDelete: Restrict)

  @@unique([orderId, ebookId])
  @@index([ebookId])
  @@map("order_items")
}

model Payment {
  id            String        @id @default(uuid()) @db.Uuid
  orderId       String        @map("order_id") @db.Uuid
  paymentMethod String        @map("payment_method") @db.VarChar(50)
  amount        Decimal       @db.Decimal(12, 2)
  status        PaymentStatus @default(PENDING)
  externalRef   String?       @map("external_ref") @db.VarChar(120)
  paidAt        DateTime?     @map("paid_at") @db.Timestamptz()
  createdAt     DateTime      @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt     DateTime      @updatedAt @map("updated_at") @db.Timestamptz()

  order         Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  transaction   Transaction?

  @@index([orderId])
  @@map("payments")
}

model Transaction {
  id              String   @id @default(uuid()) @db.Uuid
  orderId         String   @unique @map("order_id") @db.Uuid
  paymentId       String   @unique @map("payment_id") @db.Uuid
  userId          String   @map("user_id") @db.Uuid
  transactionCode String   @unique @map("transaction_code") @db.VarChar(50)
  amount          Decimal  @db.Decimal(12, 2)
  recordedAt      DateTime @default(now()) @map("recorded_at") @db.Timestamptz()

  order           Order    @relation(fields: [orderId], references: [id], onDelete: Restrict)
  payment         Payment  @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  user            User     @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId])
  @@map("transactions")
}

model EbookAccess {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  ebookId   String   @map("ebook_id") @db.Uuid
  orderId   String   @map("order_id") @db.Uuid
  grantedAt DateTime @default(now()) @map("granted_at") @db.Timestamptz()
  isRevoked Boolean  @default(false) @map("is_revoked")

  user      User     @relation(fields: [userId], references: [id], onDelete: Restrict)
  ebook     Ebook    @relation(fields: [ebookId], references: [id], onDelete: Restrict)
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Restrict)

  @@unique([userId, ebookId])
  @@index([ebookId])
  @@map("ebook_accesses")
}
