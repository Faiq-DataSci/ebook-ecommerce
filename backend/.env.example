PORT=3000
NODE_ENV=development
CORS_ORIGINS="http://localhost:5173,http://localhost:5174"

# Database PostgreSQL Supabase
DATABASE_URL="postgresql://USER:PASSWORD@HOST:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/postgres"

# Supabase Auth & Storage Privat (service role key HANYA di backend)
SUPABASE_URL="https://PROJECT_REF.supabase.co"
SUPABASE_ANON_KEY="ganti_dengan_supabase_anon_key"
SUPABASE_SERVICE_ROLE_KEY="ganti_dengan_service_role_key"
SUPABASE_EBOOK_BUCKET="ebooks-private"

# Payment Gateway (Midtrans Core API QRIS Sandbox / Xendit adapter)
PAYMENT_GATEWAY_PROVIDER="midtrans"
PAYMENT_GATEWAY_IS_PRODUCTION=false
PAYMENT_GATEWAY_BASE_URL="https://api.sandbox.midtrans.com"
PAYMENT_GATEWAY_SERVER_KEY="ganti_dengan_server_key_payment_gateway"
PAYMENT_GATEWAY_WEBHOOK_SECRET="ganti_dengan_webhook_secret"
